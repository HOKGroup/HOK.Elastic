    </appender> -->


    <!-- <root>
        <level value="DEBUG" />
        <appender-ref ref="ManagedColoredConsoleAppender" />
        <appender-ref ref="FileAppenderErrs" />
        <appender-ref ref="RollingLogFileAppenderJsonStyle" />
    </root> -->
</nlog>